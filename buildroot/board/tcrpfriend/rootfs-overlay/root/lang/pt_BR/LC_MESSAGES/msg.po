#: boot.sh:139
msgid "Detecting Internet -> "
msgstr "Detectando Internet -> "

#: boot.sh:146
msgid ""
"No internet found, Skip updating friends and installing Python libraries for "
"QR codes!"
msgstr ""
"Nenhuma internet encontrada, Pular atualizar amigos e instalar bibliotecas "
"Python para códigos QR!"

#: boot.sh:162
msgid "TCRP Friend auto update disabled"
msgstr "TCRP Amigo atualização automática desativado"

#: boot.sh:168
msgid "Checking for latest friend -> "
msgstr "Verificando para o mais recente amigo -> "

#: boot.sh:191
msgid "TCRP FRIEND HAS BEEN UPDATED, GOING FOR REBOOT"
msgstr "TCRP FRIEND FOI CRIADA, INDO PARA O REBOTE"

#: boot.sh:196
msgid "No IP yet to check for latest friend"
msgstr "Não há IP ainda para verificar para o amigo mais recente"

#: boot.sh:614
msgid "r key pressed! Entering Menu for Reset DSM Password!"
msgstr "r chave pressionada! Inserindo o menu para redefinir a senha DSM!"

#: boot.sh:620
msgid "e key pressed! Entering Menu for Edit USB/SATA Command Line!"
msgstr ""
"e chave pressionada! Menu de entrada para Editar linha de comando USB/SATA!"

#: boot.sh:626
msgid "j key pressed! Prepare Entering Force Junior (to re-install DSM)!"
msgstr "chave pressionada! Prepare Entering Force Junior (reinstalar DSM)!"

#: boot.sh:698
msgid "Unsupported loader disks other than USB, Sata DoM, mmc, NVMe, etc."
msgstr ""
"Discos de carregador não suportados que não sejam USB, Sata DoM, mmc, NVMe, "
"etc."

#: boot.sh:777
msgid "ERROR ! /mnt/tcrp-p2/rd.gz file not found, stopping boot process"
msgstr ""
"ERROR! /mnt/tcrp-p2/rd.gz ficheiro não encontrado, parando o processo de "
"arranque"

#: boot.sh:781
msgid "ERROR ! /mnt/tcrp-p2/zImage file not found, stopping boot process"
msgstr ""
"ERROR! arquivo /mnt/tcrp-p2/zImage não encontrado, parando processo de "
"inicialização"

#: boot.sh:802
msgid "Detecting upgrade : "
msgstr "Detectando atualização : "

#: boot.sh:825
msgid "A reboot is required. Press any key to reboot..."
msgstr ""
"É necessária uma reinicialização. Pressione qualquer chave para reiniciar..."

#: boot.sh:910
msgid "Not Supported Loader BUS Type, program Exit!!!"
msgstr "Não suportado Loader tipo BUS, saída do programa!!!"

#: boot.sh:932
msgid "Failed to find boot Partition on !!!"
msgstr "Falhado para encontrar a partição de inicialização em !!!"

#: boot.sh:976
msgid ""
"model is not resolved. Please check the /mnt/tcrp/user_config.json file. "
"stopping boot process"
msgstr ""
"modelo não é resolvido. Verifique o arquivo /mnt/tcrp/user_config.json. "
"processo de inicialização"

#: boot.sh:981
msgid ""
"Build version is not resolved. Please check the /mnt/tcrp/user_config.json "
"file. stopping boot process"
msgstr ""
"A versão de compilação não é resolvida. Verifique o arquivo /mnt/tcrp/"
"user_config.json. processo de inicialização"

#: boot.sh:986
msgid ""
"Update(smallfixnumber) is not resolved. Please check the /mnt/tcrp/"
"user_config.json file."
msgstr ""
"Atualização (número de pequenos ajustes) não é resolvida. Verifique o "
"arquivo /mnt/tcrp/user_config.json."

#: boot.sh:994
msgid ""
"serial is not resolved. Please check the /mnt/tcrp/user_config.json file. "
"stopping boot process"
msgstr ""
"serial não está resolvido. Verifique o arquivo /mnt/tcrp/user_config.json. "
"processo de inicialização"

#: boot.sh:1001
msgid ""
"mac1 is not resolved. Please check the /mnt/tcrp/user_config.json file. "
"stopping boot process"
msgstr ""
"mac1 não está resolvido. Verifique o arquivo /mnt/tcrp/user_config.json. "
"processo de inicialização"

#: boot.sh:1116
msgid "Press <r> to enter a menu for Reset DSM Password"
msgstr "Pressione <r> para inserir um menu para redefinir a senha DSM"

#: boot.sh:1117
msgid "Press <e> to enter a menu for Edit USB/SATA Command Line"
msgstr ""
"Pressione <e> para inserir um menu para Editar linha de comando USB/SATA"

#: boot.sh:1118
msgid "Press <j> to enter a Junior mode (to re-install DSM)"
msgstr "Pressione <j> para entrar em um modo Junior (reinstalar DSM)"

#: boot.sh:1122
msgid "Entering a Junior mode (to re-install DSM)..."
msgstr "Entrando em um modo Junior (para reinstalar DSM)..."

#: boot.sh:1137
msgid "EFI booted system with no EFI option, adding withefi to cmdline"
msgstr ""
"Sistema de inicialização EFI sem opção EFI, adicionando withefi a cmdline"

#: boot.sh:1147
msgid "Static boot set, rebooting to static ..."
msgstr "Conjunto de inicialização estática, reiniciando a estática ..."

#: boot.sh:1161
msgid "Boot timeout exceeded, booting ... "
msgstr "Tempo de inicialização excedido, inicialização ... "

#: boot.sh:1163
msgid ""
"\"HTTP, Synology Web Assistant (BusyBox httpd)\" service may take 20 - 40 "
"seconds."
msgstr ""
"\"HTTP, Synology Web Assistant (BusyBox httpd)\" serviço pode levar 20 - 40 "
"segundos."

#: boot.sh:1164
msgid "(Network access is not immediately available)"
msgstr "(O acesso à rede não está imediatamente disponível)"

#: boot.sh:1166
msgid "Kernel loading has started, nothing will be displayed here anymore ..."
msgstr "O carregamento do kernel começou, nada será exibido aqui mais ..."

#: boot.sh:1180
msgid "Booting with noefi, please notice that this might cause issues"
msgstr "Inicializando com noefi, observe que isso pode causar problemas"

#: boot.sh:1210
msgid "No NIC found! - Loader does not work without Network connection."
msgstr "Não foi encontrado! - Loader não funciona sem conexão de rede."

#: boot.sh:1108
msgid "To check the problem, access the following TTYD URL through a web browser. :"
msgstr ""
"Para verificar o problema, acesse o seguinte URL TTYD através de um "
"navegador web. :"

#: boot.sh:1109
msgid ""
"If you have any problems with the DSM installation steps, check the "
"'/var/log/linuxrc.syno.log' file in this access."
msgstr ""
"Se tiver algum problema com as etapas de instalação do DSM, verifique o "
"arquivo '/var/log/linuxrc.syno.log' neste acesso."

#: boot.sh:1110
msgid "Default TTYD root password is 'blank' "
msgstr "Palavra-passe de raiz padrão TTYD é 'blank ' "

#: boot.sh:1111
msgid "User config is on '/mnt/tcrp/user_config.json'"
msgstr "A configuração do usuário está em '/mnt/tcrp/user_config.json '"

#: boot.sh:1147
msgid "Press <m> to mask/unmask sensitive info (Serial/MAC) for screenshot sharing"
msgstr "Pressione <m> para ocultar/exibir informações sensíveis (Número de série/MAC) antes de compartilhar uma captura de tela"

#: boot.sh:1149
msgid "m key pressed! Sensitive info (Serial/MAC) is now masked for screenshot sharing"
msgstr "Tecla m pressionada! As informações sensíveis (Número de série/MAC) agora estão ocultas para compartilhamento de captura de tela"

#: boot.sh:1153
msgid "m key pressed! Sensitive info (Serial/MAC) is now unmasked"
msgstr "Tecla m pressionada! As informações sensíveis (Número de série/MAC) não estão mais ocultas"
